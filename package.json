{
  "name": "appointment-capacity-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src e2e *.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:claims": "npm run build && playwright test e2e/claims.spec.ts",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
